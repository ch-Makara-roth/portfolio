# =============================================================================
# PORTFOLIO ENVIRONMENT CONFIGURATION - EXAMPLE
# =============================================================================
# Copy this file to .env.local for local development
# Fill in the actual values for your environment
# Never commit sensitive values to version control

# =============================================================================
# BASIC APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# SITE CONFIGURATION (Public Variables)
# =============================================================================
# These variables are exposed to the browser (prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Your Name - Full Stack Developer"
NEXT_PUBLIC_SITE_DESCRIPTION="Your portfolio description here"

# =============================================================================
# ANALYTICS & TRACKING
# =============================================================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# =============================================================================
# SEO & VERIFICATION
# =============================================================================
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
NEXT_PUBLIC_YANDEX_VERIFICATION=your-yandex-verification-code
NEXT_PUBLIC_YAHOO_VERIFICATION=your-yahoo-verification-code
NEXT_PUBLIC_BING_VERIFICATION=your-bing-verification-code

# =============================================================================
# SOCIAL MEDIA
# =============================================================================
NEXT_PUBLIC_TWITTER_HANDLE=@your-twitter-handle
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/your-profile

# =============================================================================
# BUILD & DEPLOYMENT INFO
# =============================================================================
BUILD_TIME=2024-01-01T00:00:00.000Z
COMMIT_HASH=abc123def456
VERCEL_URL=your-app.vercel.app
VERCEL_GIT_COMMIT_SHA=abc123def456

# =============================================================================
# DATABASE (Optional - for future backend integration)
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/portfolio
POSTGRES_URL=postgresql://username:password@localhost:5432/portfolio
POSTGRES_PRISMA_URL=postgresql://username:password@localhost:5432/portfolio?pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgresql://username:password@localhost:5432/portfolio

# =============================================================================
# AUTHENTICATION (Optional - for admin features)
# =============================================================================
NEXTAUTH_SECRET=your-nextauth-secret-key-here
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here

# =============================================================================
# EMAIL SERVICE (Optional - for contact form)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# FILE STORAGE & CDN (Optional)
# =============================================================================
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# =============================================================================
# REDIS (Optional - for caching)
# =============================================================================
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# =============================================================================
# MONITORING & LOGGING (Optional)
# =============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
LOGTAIL_TOKEN=your-logtail-token

# =============================================================================
# API KEYS (Optional - for external services)
# =============================================================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# RATE LIMITING (Optional)
# =============================================================================
UPSTASH_REDIS_REST_URL_RATE_LIMIT=https://your-rate-limit-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN_RATE_LIMIT=your-rate-limit-token

# =============================================================================
# WEBHOOK SECRETS (Optional)
# =============================================================================
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
ANALYZE=false
BUNDLE_ANALYZE=false